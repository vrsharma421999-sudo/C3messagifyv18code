<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Delivery_Status__c</fullName>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Status__c), &quot;&quot;,
    IMAGE(
        CASE(Status__c,
            &quot;Sent&quot;, &quot;/resource/CCCWA__SingleTickWhatsApp&quot;,
            &quot;Delivered&quot;, &quot;/resource/CCCWA__DoubleTickWhatsAppGrey&quot;,
            &quot;Read&quot;, &quot;/resource/CCCWA__BlueDoubleTick&quot;,
            &quot;Failed&quot;, &quot;/img/msg_icons/error16.png&quot;,
            &quot;&quot;
        ),
        Status__c,
        16, 16
    ) &amp; &quot; &quot; &amp; Status__c
)</formula>
    <label>Delivery Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
